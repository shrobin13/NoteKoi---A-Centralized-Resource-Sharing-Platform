# ---------------------------------------------------------------------------
# NoteKoi API environment template.
# Copy this file to apps/api/.env and fill in the real values.
# apps/api/.env is git-ignored; never commit it or paste it into a chat.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000
# Next.js dev server origin (used later for CORS + the httpOnly auth cookie)
WEB_ORIGIN=http://localhost:3000

# PostgreSQL — the developer's LOCAL instance on 5432 (not in docker-compose)
DATABASE_URL="postgresql://postgres:password@localhost:5432/my_database?schema=public"
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/my_database_test?schema=public"

# Redis — docker compose up -d redis  (image redis:7, published on 6379)
REDIS_URL=redis://localhost:6379

# Auth — JWT access token (sub + jti only)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=24h

# Email (Nodemailer / SMTP) — e.g. a Gmail app password or a Mailtrap sandbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NoteKoi <no-reply@example.com>"

# Google Drive (service account; downloads are proxied by the API)
# Either an absolute path to the service-account JSON key file (keep that file
# OUTSIDE this repo) or the raw JSON on a single line.
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_ROOT_FOLDER_ID=
# Only needed when pointing at a Drive API mock/emulator during development.
GOOGLE_DRIVE_API_BASE_URL=https://www.googleapis.com/drive/v3

# File storage (S3-B2). google-drive is the only driver in production; local
# writes into the git-ignored LOCAL_STORAGE_DIR so dev/test needs no credentials.
# Leave STORAGE_DRIVER empty to auto-pick: Drive when configured, else local.
STORAGE_DRIVER=
LOCAL_STORAGE_DIR=storage

# Uploads
MAX_UPLOAD_MB=50
# Lifetime of the short-lived upload token (D21) the browser uses to post a file.
UPLOAD_TOKEN_TTL_SECONDS=300

# Dev seed script only (S1-B14): password for the seeded demo accounts.
# Required when NODE_ENV=production (the seed refuses to run without it).
SEED_PASSWORD=Password123!