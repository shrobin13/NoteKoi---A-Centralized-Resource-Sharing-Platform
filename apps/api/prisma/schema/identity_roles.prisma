model User {
  id           String @id @default(uuid()) @db.Uuid
  name         String
  email        String @unique
  passwordHash String

  accountStatus AccountStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile   StudentProfile?
  teacherProfile   TeacherProfile?
  roles            UserRole[]       @relation("RoleHolder")
  rolesAssigned    UserRole[]       @relation("RoleAssigner")
  studentsVerified StudentProfile[] @relation("StudentVerifiedBy")
  teachersVerified TeacherProfile[] @relation("TeacherVerifiedBy")

  foldersOwned        Folder[]
  resourcesUploaded   Resource[]             @relation("ResourceUploader")
  resourcesPromoted   Resource[]             @relation("ResourcePromoter")
  resourcesFlagged    Resource[]             @relation("ResourceDeletionFlagger")
  resourcesDeleted    Resource[]             @relation("ResourceDeleter")
  versionsUploaded    ResourceVersion[]      @relation("VersionUploader")
  batchGrantsGiven    ResourceBatchGrant[]   @relation("GrantGiver")
  auditLogs           AuditLog[]
  reportsSubmitted    Report[]               @relation("ReportReporter")
  reportsResolved     Report[]               @relation("ReportResolver")
  deletionRequests    DeletionRequest[]      @relation("DeletionRequester")
  deletionDecisions   DeletionRequest[]      @relation("DeletionDecider")
  escalationsRaised   ModerationEscalation[] @relation("EscalationCreator")
  escalationsAssigned ModerationEscalation[] @relation("EscalationAssignee")
  commentsAuthored    Comment[]              @relation("CommentAuthor")
  notifications       Notification[]

  @@map("users")
}

model StudentProfile {
  id String @id @default(uuid()) @db.Uuid

  userId       String @unique @db.Uuid
  collegeId    String @db.Uuid
  departmentId String @db.Uuid
  sessionId    String @db.Uuid

  regNo String

  verificationStatus ProfileVerificationStatus @default(PENDING_VERIFICATION)
  verifiedById       String?                   @db.Uuid
  verifiedBy         User?                     @relation("StudentVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt         DateTime?

  rejectedReason String?
  rejectedById   String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user              User              @relation(fields: [userId], references: [id])
  college           College           @relation(fields: [collegeId], references: [id])
  department        Department        @relation(fields: [departmentId], references: [id])
  collegeDepartment CollegeDepartment @relation(fields: [collegeId, departmentId], references: [collegeId, departmentId])
  session           Session           @relation(fields: [sessionId, departmentId], references: [id, departmentId])

  @@unique([collegeId, regNo], name: "unique_student_reg_no_per_college")
  @@index([departmentId, sessionId], name: "idx_student_department_session")
  @@index([verificationStatus], name: "idx_student_verification_status")
  @@map("student_profiles")
}

model UserRole {
  id String @id @default(uuid()) @db.Uuid

  userId String       @db.Uuid
  role   UserRoleType
  scope  RoleScope

  collegeId    String? @db.Uuid
  departmentId String? @db.Uuid
  sessionId    String? @db.Uuid
  assignedById String? @db.Uuid

  appointmentType AppointmentType @default(STANDARD)

  assignedAt DateTime  @default(now())
  expiresAt  DateTime?

  reason      String?
  revokedById String?   @db.Uuid
  revokedAt   DateTime?

  user       User        @relation("RoleHolder", fields: [userId], references: [id])
  assignedBy User?       @relation("RoleAssigner", fields: [assignedById], references: [id])
  college    College?    @relation(fields: [collegeId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  session    Session?    @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, revokedAt], name: "idx_user_role_user_revoked")
  @@index([collegeId, role, revokedAt], name: "idx_user_role_college_role_revoked")
  @@index([departmentId, sessionId, role], name: "idx_user_role_department_session_role")
  @@map("user_roles")
}

model TeacherProfile {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @unique @db.Uuid
  collegeId          String              @db.Uuid
  teacherDepartments TeacherDepartment[]

  verificationStatus ProfileVerificationStatus @default(PENDING_VERIFICATION)

  verifiedById String?   @db.Uuid
  verifiedAt   DateTime?

  rejectedReason String?
  rejectedById   String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User    @relation(fields: [userId], references: [id])
  verifiedBy User?   @relation("TeacherVerifiedBy", fields: [verifiedById], references: [id])
  college    College @relation(fields: [collegeId], references: [id])

  @@index([collegeId, verificationStatus], name: "idx_teacher_verification_status")
  @@map("teacher_profiles")
}

model TeacherDepartment {
  id               String   @id @default(uuid()) @db.Uuid
  teacherProfileId String   @db.Uuid
  departmentId     String   @db.Uuid
  assignedAt       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  department     Department     @relation(fields: [departmentId], references: [id])

  @@unique([teacherProfileId, departmentId], name: "unique_teacher_department")
  @@index([departmentId], name: "idx_teacher_department")
  @@map("teacher_departments")
}
