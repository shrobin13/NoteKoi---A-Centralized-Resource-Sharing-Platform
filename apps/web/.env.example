# ---------------------------------------------------------------------------
# NoteKoi web environment template.
# Copy to apps/web/.env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Prefix the browser uses. Keep it relative so every call goes through the
# Next.js proxy below (same origin => the httpOnly cookie works everywhere).
NEXT_PUBLIC_API_URL=/api/v1

# Where the Next.js server forwards /api/* (the Express API).
API_PROXY_TARGET=http://localhost:5000

# Optional direct Express API base URL for large multipart uploads that must bypass Vercel.
# Include the API path (for example, the same base path used by NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_UPLOAD_API_URL=

# DEV ONLY — the "Demo accounts" panel under the login form.
# Set to true in apps/web/.env.local to list the seeded @notekoi.local accounts
# (apps/api/prisma/seed.ts) and fill the email field with one click. It never
# shows the password. Leave it false/unset here: a production build
# (NODE_ENV=production) drops the panel and its data from the bundle regardless,
# so Vercel needs no change.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false

